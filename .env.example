# Backend Runtime Secrets (Store exclusively on backend server environment)
# Never expose to client JS bundles or Android APK assets.

# Server-side Gemini API key (Application default key)
GEMINI_API_KEY=

# Cloudflare Workers AI Credentials (For zero-cost FLUX.1 [schnell] text-to-image synthesis)
# Account ID from Cloudflare Dashboard -> Workers & Pages -> Account ID
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token with Workers AI Read permissions
CLOUDFLARE_API_TOKEN=

# Public Frontend Configuration (Optional)
# Set when packaging for Capacitor Android to point the APK WebView to your deployed backend.
# Leave blank for standard Web / AI Studio preview (uses same-origin relative /api paths).
VITE_API_URL=
